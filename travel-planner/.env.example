# ---------------------------------------------------------------------------
# Wanderplan environment template. Copy to .env.local and fill in.
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the browser;
# everything else stays on the server.
# ---------------------------------------------------------------------------

# Public URL of the site (used in e-mails, calendar feeds and OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. Safe for the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security. Used by the calendar feed, Google sync, cron jobs and
# the seed script. Never expose it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets generated by you ------------------------------------------------
# Signs calendar-subscription URLs and OAuth state.   openssl rand -base64 32
FEED_SIGNING_SECRET=
# Encrypts Google OAuth tokens at rest (AES-256-GCM, 32 bytes).   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <value>").
CRON_SECRET=

# --- Google Calendar sync (optional; the feature is hidden until both are set) ----
# Google Cloud console → APIs & Services → enable "Google Calendar API", create an OAuth client
# (Web application) with redirect URI  <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (optional; Resend). Without it, invitations show a link to copy instead. -----
RESEND_API_KEY=
EMAIL_FROM="Wanderplan <trips@example.com>"

# --- Map (optional) -----------------------------------------------------------
# Default: OpenStreetMap tiles, no key needed (fine for development / light use; see README for
# OSM's tile usage policy). To use another provider, set a Leaflet tile URL template + attribution:
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Nominatim (place search) asks for a contact address in the User-Agent.
NOMINATIM_CONTACT_EMAIL=

# --- Google sign-in button (optional) ---------------------------------------------
# Set to "true" only after enabling the Google provider in Supabase → Authentication → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
